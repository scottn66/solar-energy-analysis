# Solar Energy Analysis — Environment Variables
# ================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Get a free NREL API key (30 seconds):
#   https://developer.nrel.gov/signup/
#
# This key works for both PVWatts and the OpenEI URDB rate database.
#
# Get a free EIA API key (for live electricity price lookups):
#   https://www.eia.gov/opendata/register.php
#
# Never commit .env to git — it's already in .gitignore.

NREL_API_KEY=your_api_key_here
EIA_API_KEY=your_eia_key_here
